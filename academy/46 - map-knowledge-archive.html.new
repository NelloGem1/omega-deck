<h3 id="63-database-schemas">6.3 Database schemas</h3>
<h4 id="631-postgresql-canonical-metadata-store">6.3.1 PostgreSQL — canonical metadata store</h4>
<pre><code class="language-sql">-- Users &amp; identity
CREATE TABLE users (
  id            UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  did           TEXT UNIQUE,                -- decentralized identifier
  display_name  TEXT,
  public_key    BYTEA,                      -- Ed25519 for signing contributions
  reputation    NUMERIC(5,2) DEFAULT 0,     -- Section 7
  created_at    TIMESTAMPTZ DEFAULT now(),
  status        TEXT DEFAULT 'active'       -- active/suspended/banned
);

-- Nodes (every knowledge node has a row here)
CREATE TABLE nodes (
  id              UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  node_type       TEXT NOT NULL,            -- Domain/Discipline/.../Lesson
  slug            TEXT UNIQUE NOT NULL,     -- URL-safe identifier
  title           TEXT NOT NULL,
  content_md      TEXT,                     -- markdown body
  content_hash    BYTEA NOT NULL,           -- SHA-256 of content (integrity)
  epistemic_tier  SMALLINT NOT NULL CHECK (epistemic_tier BETWEEN 1 AND 9),
  knowledge_class TEXT NOT NULL,            -- discovery/math/experience/...
  domain          TEXT,                     -- denormalized for fast filter
  discipline      TEXT,
  language        TEXT DEFAULT 'en',
  confidence      NUMERIC(4,3),
  uncertainty     JSONB DEFAULT '{}',
  valid_from      TIMESTAMPTZ,
  valid_until     TIMESTAMPTZ,
  superseded_by   UUID REFERENCES nodes(id),
  created_by      UUID REFERENCES users(id),
  created_at      TIMESTAMPTZ DEFAULT now(),
  updated_at      TIMESTAMPTZ DEFAULT now(),
  version         INT DEFAULT 1,
  ipfs_cid        TEXT                      -- content-addressed blob pointer
);
CREATE INDEX idx_nodes_tier ON nodes(epistemic_tier);
CREATE INDEX idx_nodes_type ON nodes(node_type);
CREATE INDEX idx_nodes_domain ON nodes(domain, discipline);
CREATE INDEX idx_nodes_content_hash ON nodes(content_hash);

-- Edges (knowledge graph relationships — mirrored in graph DB)
CREATE TABLE edges (
  id            UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  src_node      UUID NOT NULL REFERENCES nodes(id),
  dst_node      UUID NOT NULL REFERENCES nodes(id),
  edge_type     TEXT NOT NULL,              -- PART_OF/EVIDENCES/...
  weight        NUMERIC(4,3) DEFAULT 1.0,
  source        TEXT,                       -- justification for the edge
  valid_from    TIMESTAMPTZ,
  valid_until   TIMESTAMPTZ,
  created_by    UUID REFERENCES users(id),
  created_at    TIMESTAMPTZ DEFAULT now(),
  UNIQUE(src_node, dst_node, edge_type)
);
CREATE INDEX idx_edges_src ON edges(src_node, edge_type);
CREATE INDEX idx_edges_dst ON edges(dst_node, edge_type);

-- Experience records (the Section 5 schema, as JSONB + indexed fields)
CREATE TABLE experience_records (
  id              UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  node_id         UUID REFERENCES nodes(id),  -- the n: node for this record
  record          JSONB NOT NULL,              -- full Section 5 schema
  epistemic_tier  SMALLINT NOT NULL,
  experience_type TEXT NOT NULL,               -- lab_experiment/field_deployment/...
  failure_flag    BOOLEAN DEFAULT false,       -- has non-empty failures block
  lessons         TEXT[],                      -- extracted lesson strings
  searchable_tsv  tsvector,                    -- full-text index
  created_at      TIMESTAMPTZ DEFAULT now()
);

-- Evidence records
CREATE TABLE evidence (
  id              UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  node_id         UUID REFERENCES nodes(id),
  evidence_type   TEXT NOT NULL,               -- raw_data/images/third_party/...
  location        TEXT NOT NULL,               -- dataset/artifact/paper pointer
  reproducible    BOOLEAN DEFAULT false,
  replication_count INT DEFAULT 0,
  independent_replications INT DEFAULT 0,
  retraction_status TEXT DEFAULT 'none',       -- none/retracted/under_review
  methodology_rigor NUMERIC(3,2),
  funding_conflicts JSONB DEFAULT '[]',
  created_at      TIMESTAMPTZ DEFAULT now()
);

-- Provenance / audit chain (hash-linked, tamper-evident)
CREATE TABLE audit_log (
  seq             BIGSERIAL PRIMARY KEY,
  prev_hash       BYTEA NOT NULL,              -- hash of previous record
  record_hash     BYTEA NOT NULL,              -- hash of this record
  actor           UUID REFERENCES users(id),
  action          TEXT NOT NULL,               -- create/update/delete/verify/demote
  target_type     TEXT NOT NULL,               -- node/edge/evidence/user
  target_id       UUID NOT NULL,
  payload         JSONB,
  signature       BYTEA NOT NULL,              -- Ed25519 signature
  timestamp       TIMESTAMPTZ DEFAULT now()
);

-- Contradictions &amp; controversies
CREATE TABLE controversies (
  id              UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  node_id         UUID REFERENCES nodes(id),
  title           TEXT NOT NULL,
  description     TEXT,
  resolution_status TEXT DEFAULT 'open',       -- open/resolved_*/unresolved
  resolution_evidence JSONB DEFAULT '[]',
  created_at      TIMESTAMPTZ DEFAULT now()
);

-- Verification events (tier promotions/demotions)
CREATE TABLE verification_events (
  id              UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  node_id         UUID NOT NULL REFERENCES nodes(id),
  from_tier       SMALLINT NOT NULL,
  to_tier         SMALLINT NOT NULL,
  reason          TEXT NOT NULL,
  evidence_refs   UUID[],
  verifier        UUID REFERENCES users(id),
  verified_at     TIMESTAMPTZ DEFAULT now()
);

-- Translations
CREATE TABLE translations (
  id              UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  node_id         UUID NOT NULL REFERENCES nodes(id),
  language        TEXT NOT NULL,
  title           TEXT NOT NULL,
  content_md      TEXT NOT NULL,
  translator      UUID REFERENCES users(id),
  machine_translated BOOLEAN DEFAULT false,
  verified        BOOLEAN DEFAULT false,
  created_at      TIMESTAMPTZ DEFAULT now(),
  UNIQUE(node_id, language)
);
</code></pre>
<h4 id="632-graph-db-schema-neo4j-cypher">6.3.2 Graph DB schema (Neo4j Cypher)</h4>
<pre><code class="language-cypher">// Node labels mirror node_type; properties mirror critical fields
CREATE (d:Domain {slug:'natural-sciences', title:'Natural Sciences',
                  epistemic_tier:1, language:'en'})
CREATE (disc:Discipline {slug:'physics', title:'Physics',
                  epistemic_tier:1, domain:'natural-sciences'})
CREATE (sub:Subdiscipline {slug:'plasma-physics', title:'Plasma Physics',
                  epistemic_tier:1, discipline:'physics'})
CREATE (f:Field {slug:'magnetic-confinement-fusion', title:'Magnetic Confinement Fusion',
                  epistemic_tier:3, subdiscipline:'plasma-physics'})
CREATE (c:Concept {slug:'tokamak', title:'Tokamak',
                  epistemic_tier:1, field:'magnetic-confinement-fusion'})

// Edges
CREATE (c)-[:PART_OF {weight:1.0, source:'canonical-map'}]-&gt;(f)
CREATE (f)-[:PART_OF {weight:1.0}]-&gt;(sub)
CREATE (sub)-[:PART_OF {weight:1.0}]-&gt;(disc)
CREATE (disc)-[:PART_OF {weight:1.0}]-&gt;(d)

// Evidence edge
CREATE (e:Evidence {slug:'jet-dt-1997', replication_count:14,
                    independent_replications:9, epistemic_tier:1})
CREATE (e)-[:EVIDENCES {weight:0.95, source:'JET-NF-1998'}]-&gt;(c)

// Failure edge — the killer feature
CREATE (fail:Failure {slug:'jet-disruption-damage',
                      root_cause:'disruption-induced EM forces',
                      epistemic_tier:4})
CREATE (fail)-[:INVALIDATES {weight:0.9}]-&gt;(m:Method {slug:'high-beta-operation'})
CREATE (lesson:Lesson {slug:'disruption-mitigation-required'})
CREATE (fail)-[:YIELDS_LESSON]-&gt;(lesson)
CREATE (lesson)-[:TEACHES]-&gt;(c)
</code></pre>
<p><strong>Graph DB is the query engine; PostgreSQL is the source of truth.</strong>
Nodes/edges are written to Postgres first (ACID, audit log), then
asynchronously projected into the graph DB for traversal queries. The
graph DB is rebuildable from Postgres at any time.</p>
<h4 id="633-vector-db-schema-pgvector-qdrant-lancedb">6.3.3 Vector DB schema (pgvector / Qdrant / LanceDB)</h4>
<pre><code class="language-sql">-- pgvector (if using Postgres extension)
CREATE EXTENSION vector;

CREATE TABLE node_embeddings (
  node_id       UUID PRIMARY KEY REFERENCES nodes(id),
  chunk_idx     INT NOT NULL,               -- for long documents
  content       TEXT NOT NULL,              -- the chunk text
  embedding     vector(1024) NOT NULL,      -- BGE-M3 / E5 dimension
  metadata      JSONB DEFAULT '{}',         -- tier, domain, language, node_type
  created_at    TIMESTAMPTZ DEFAULT now(),
  UNIQUE(node_id, chunk_idx)
);
CREATE INDEX idx_embeddings_hnsw
  ON node_embeddings USING hnsw (embedding vector_cosine_ops);

-- Hybrid search: combine with tsvector
ALTER TABLE node_embeddings ADD COLUMN tsv tsvector
  GENERATED ALWAYS AS (to_tsvector('english', content)) STORED;
CREATE INDEX idx_embeddings_tsv ON node_embeddings USING gin(tsv);
</code></pre>
<p>For Qdrant (production scale):</p>
<pre><code class="language-python"># Collection config
client.create_collection(
    collection_name=&quot;knowledge_chunks&quot;,
    vectors_config={
        &quot;dense&quot;: VectorParams(size=1024, distance=Distance.COSINE),
        &quot;sparse&quot;: SparseVectorParams()
    },
    on_disk_payload=True   # for large payloads
)
# Payload: {node_id, chunk_idx, epistemic_tier, domain, language, node_type}
</code></pre>
<h3 id="64-api-design">6.4 API design</h3>
<p>REST + GraphQL for the knowledge graph. Base: <code>/api/v1</code></p>
<h4 id="core-endpoints">Core endpoints</h4>
<pre><code># Search (hybrid: semantic + keyword + graph + filters)
POST /api/v1/search
  body: {query, mode: 'hybrid'|'semantic'|'keyword'|'graph',
         filters: {domain, discipline, epistemic_tier_max, language,
                   include_failures: true, date_range},
         limit: 20, offset: 0}
  → {results: [{node_id, title, snippet, tier, score, citations}],
     uncertainty: {...}, graph_context: {...}}

# Node retrieval
GET  /api/v1/nodes/{slug}
  → full node + edges (k-hop configurable) + evidence + experience record

GET  /api/v1/nodes/{slug}/neighborhood?depth=2&amp;edge_types=PART_OF,EVIDENCES,INVALIDATES
  → subgraph for graph-RAG context assembly

# Graph queries (power users / AI engine)
POST /api/v1/graph/query
  body: {cypher: &quot;MATCH (n:Concept)...&quot;, params: {...}}
  → {nodes, edges, truncation_info}

# Experience records
POST /api/v1/experiences          # submit (requires auth + DID signature)
GET  /api/v1/experiences/{id}
GET  /api/v1/experiences?type=lab_experiment&amp;has_failures=true&amp;domain=...

# Verification
POST /api/v1/nodes/{id}/verify    # submit verification evidence → tier review
GET  /api/v1/nodes/{id}/verification-history
POST /api/v1/nodes/{id}/dispute   # flag contradiction → creates controversy node

# AI assistant
POST /api/v1/ask
  body: {query, include_experiences: true, citation_depth: 3}
  → {answer, citations: [{node_id, claim, tier}], uncertainty, failure_modes}

# Gap reports
GET  /api/v1/gaps                 # under-connected questions, evidence deserts
GET  /api/v1/gaps/{id}

# Translation
GET  /api/v1/nodes/{id}?lang=sw   # returns translated version if available
POST /api/v1/nodes/{id}/translate # request/submit translation

# Bulk / export
GET  /api/v1/export?format=jsonl|parquet&amp;domain=...
GET  /api/v1/sync?since=timestamp # offline/edge sync protocol
</code></pre>
<h4 id="auth-contribution">Auth &amp; contribution</h4>
<pre><code>POST /api/v1/auth/register        # DID creation, key generation
POST /api/v1/auth/login           # challenge-response with Ed25519 key
POST /api/v1/contributions        # submit new node/edge/evidence/experience
POST /api/v1/contributions/{id}/endorse   # peer endorsement (+reputation)
POST /api/v1/contributions/{id}/dispute   # challenge (-reputation)
</code></pre>
<p>All write endpoints require: DID signature, rate limiting, automated
screening (Section 7), and entry into the <code>staging</code> tier until verified
(T8 by default — promotion requires review/endorsement/replication).</p>
<h3 id="65-ai-retrieval-pipeline-detailed">6.5 AI retrieval pipeline (detailed)</h3>
<pre><code>User query
   │
   ▼
[1] QUERY UNDERSTANDING (LLM)
    - intent classification (search/ask/explore/verify)
    - entity extraction → candidate node slugs
    - epistemic intent: &quot;what is verified about X&quot; vs &quot;what have people
      experienced with X&quot; vs &quot;what failed with X&quot;
   │
   ▼
[2] MULTI-CHANNEL RETRIEVAL (parallel)
    ├─ dense vector: top-50 chunks (BGE-M3 embeddings)
    ├─ BM25: top-50 keyword matches
    ├─ graph: seed entities → 2-hop neighborhood
    │         (PART_OF up, EVIDENCES/INVALIDATES down)
    └─ structured: filters on tier/domain/date/language
   │
   ▼
[3] FUSION &amp; RERANK
    - Reciprocal Rank Fusion across channels
    - cross-encoder rerank top-100 → top-20
    - epistemic tier boost: T1-T3 boosted for factual queries;
      T6 boosted for &quot;experience&quot; queries
   │
   ▼
[4] SUBGRAPH ASSEMBLY (graph-RAG)
    - collect evidence nodes, failure nodes, lesson nodes,
      controversy nodes for each result
    - serialize to prompt with node-ID citation anchors
   │
   ▼
[5] SYNTHESIS (LLM)
    - generate answer grounded in assembled context
    - mandatory citation format: [node:slug#chunk]
    - uncertainty block from aggregate tier of cited nodes
   │
   ▼
[6] VERIFICATION PASS
    - check every citation resolves to a real node
    - check cited node tier matches claim strength
    - strip or flag uncited claims
    - check contradiction nodes are surfaced if relevant
   │
   ▼
[7] RESPONSE
    {answer, citations[], uncertainty{},
     failure_modes[] (if applicable),
     controversies[] (if applicable),
     gaps_suggested[] (related open questions)}
</code></pre>
<h3 id="66-distributed-storage-strategy">6.6 Distributed storage strategy</h3>
<p><strong>Phase 1 (prototype):</strong> single Postgres + Qdrant + Neo4j on one machine.
<strong>Phase 2 (national/regional):</strong> PostgreSQL read replicas, Qdrant cluster,
Neo4j causal cluster, S3 object storage, CDN.
<strong>Phase 3 (global):</strong></p>
<ul>
<li><strong>Sharding by domain:</strong> each discipline cluster owns its subgraph;
  cross-domain links via a federated query layer.</li>
<li><strong>IPFS/Filecoin</strong> for immutable document storage — content-addressed,
  no single point of failure, censorship-resistant.</li>
<li><strong>Byzantine fault-tolerant replication</strong> of the audit log <code>[SPEC]</code>.</li>
<li><strong>Merkle-tree integrity:</strong> every node's content hash chains into a
  global Merkle root, periodically anchored to a public blockchain
  (or a public transparency log like Certificate Transparency) for
  tamper-evident timestamps <code>[EXISTS: CT logs; SPEC: full BFT consensus]</code>.</li>
</ul>
<h3 id="67-crypto-integrity-model">6.7 Crypto integrity model</h3>
<pre><code>Every node:
  content_hash = SHA-256(canonical_serialization(node))
  signature   = Ed25519_sign(content_hash, author_private_key)

Every edge:
  edge_hash   = SHA-256(src_id + dst_id + edge_type + weight + timestamp)

Audit log:
  record_hash = SHA-256(prev_hash + payload + timestamp + signature)
  → tamper-evident chain; any modification breaks all subsequent hashes

Global state:
  merkle_root = Merkle(root of all node_hashes)
  → anchored externally (blockchain / transparency log) every N hours
  → anyone can verify any node's inclusion without trusting the archive
</code></pre>
<p>This gives <strong>verifiable integrity without trusting the operator</strong> —
the archive can prove "this claim existed on date X with this content"
even if the operator is compromised.</p>
<h3 id="68-implementation-roadmap">6.8 Implementation roadmap</h3>
<h4 id="phase-0-beginner-prototype-weeks-18-start-here">Phase 0 — Beginner Prototype (Weeks 1–8) — <strong>START HERE</strong></h4>
<p><em>Goal: prove the concept with one domain, manual curation.</em></p>
<p><strong>Tech:</strong> Python + SQLite (or single Postgres) + LanceDB (embedded vectors)
+ markdown files + simple web UI. <strong>No graph DB yet</strong> — edges in SQLite.
<strong>Domain:</strong> pick ONE narrow domain (e.g., "battery failure modes" or
"lean theorem proving"). Manually seed 50–200 nodes.</p>
<p>Deliverables:
- <code>nodes</code> + <code>edges</code> + <code>experience_records</code> tables (SQLite)
- Markdown ingestion script → node extraction (regex/LLM-assisted)
- LanceDB vector index for semantic search
- Simple FastAPI <code>/search</code> and <code>/ask</code> endpoints
- Single-page web UI (search + node view + experience record view)
- Manual verification workflow (admin promotes T8→T6→T4)</p>
<p><strong>Success criterion:</strong> can answer "what has failed with X and why" for
the seed domain, with citations and failure records visible.</p>
<h4 id="phase-1-mvp-months-24">Phase 1 — MVP (Months 2–4)</h4>
<ul>
<li>Migrate to PostgreSQL + pgvector (keep LanceDB for edge)</li>
<li>Add Neo4j Community for graph queries</li>
<li>Implement hybrid retrieval (vector + BM25 + graph traversal)</li>
<li>LLM integration (self-hosted Llama 3.1 8B or API)</li>
<li>Experience record submission form + review queue</li>
<li>Basic verification workflow (endorse/dispute)</li>
<li>Simple auth (email + API key; DID later)</li>
<li>3 domains seeded, ~1000 nodes</li>
</ul>
<h4 id="phase-2-multi-domain-months-59">Phase 2 — Multi-domain (Months 5–9)</h4>
<ul>
<li>NLLB-200 translation pipeline (EN↔ES↔ZH↔AR↔HI first)</li>
<li>Whisper transcription for oral histories</li>
<li>Docling/MinerU for PDF ingestion</li>
<li>Contradiction detection (automated CONTRADICTS edge suggestion)</li>
<li>Gap detection reports (weekly auto-generated)</li>
<li>Reputation system v1 (endorsements, contribution quality)</li>
<li>Mobile PWA + offline mode (LanceDB sync)</li>
<li>10 domains, ~10k nodes</li>
</ul>
<h4 id="phase-3-scale-months-1018">Phase 3 — Scale (Months 10–18)</h4>
<ul>
<li>Qdrant cluster for vector search at scale</li>
<li>Neo4j Enterprise or FalkorDB for graph analytics</li>
<li>IPFS integration for document storage</li>
<li>Merkle-tree integrity + transparency log anchoring</li>
<li>DID/VC identity (did:key, did:web)</li>
<li>Multi-region deployment, CDN</li>
<li>Graph-RAG with community detection (LightRAG patterns)</li>
<li>Outcome learning pipeline (feedback → reranking)</li>
<li>50+ domains, ~100k nodes</li>
</ul>
<h4 id="phase-4-global-year-2">Phase 4 — Global (Year 2+)</h4>
<ul>
<li>Federated architecture: domain clusters with cross-cluster query layer</li>
<li>Byzantine fault tolerance for audit log <code>[SPEC]</code></li>
<li>Zero-knowledge provenance <code>[SPEC]</code></li>
<li>Neural-symbolic verification for math/physics <code>[SPEC]</code></li>
<li>Integration with existing archives (arXiv, PubMed, museum databases,
  oral history projects) via adapters</li>
<li>Governance transition to multi-stakeholder foundation</li>
</ul>
<hr />
<h2 id="7-security-governance">7. SECURITY &amp; GOVERNANCE</h2>
<h3 id="71-threat-model">7.1 Threat model</h3>
<table>
<thead>
<tr>
<th>Threat</th>
<th>Attack vector</th>
<th>Mitigation</th>
</tr>
</thead>
<tbody>
<tr>
<td><strong>Poisoning</strong></td>
<td>Submit false claims, fake evidence, sockpuppet endorsements</td>
<td>Tier gating (all submissions start T8), reputation-weighted endorsement, automated fact-checking, cryptographic attribution</td>
</tr>
<tr>
<td><strong>Manipulation</strong></td>
<td>Edit history, gaslighting contributors, edit wars</td>
<td>Immutable audit log (hash-chained), signed contributions, dispute resolution protocol, version history always preserved</td>
</tr>
<tr>
<td><strong>Cyberattack</strong></td>
<td>DDoS, injection, data exfiltration, supply chain</td>
<td>Standard hardening (OWASP Top 10), rate limiting, WAF, dependency scanning, bug bounty, least-privilege access</td>
</tr>
<tr>
<td><strong>Capture/monopoly</strong></td>
<td>Single entity controls the archive, censors inconvenient knowledge</td>
<td>Federated architecture, IPFS content addressing, open-source code, multi-stakeholder governance, no single point of control</td>
</tr>
<tr>
<td><strong>Censorship</strong></td>
<td>Government/corporate demands to remove content</td>
<td>Content-addressed storage (can't delete from IPFS), jurisdictional diversity, legal defense fund, transparency reports</td>
</tr>
<tr>
<td><strong>Misinformation</strong></td>
<td>AI-generated fake nodes, deepfake evidence, LLM slop at scale</td>
<td>Provenance requirements, evidence floor, anti-AI-detection screening, human review for high-impact claims, source diversity requirements</td>
</tr>
<tr>
<td><strong>Privacy violation</strong></td>
<td>Exposure of personal experiences, indigenous knowledge without consent</td>
<td>Differential privacy for aggregate queries, consent framework for T6 records, right-to-be-forgotten with cryptographic erasure, jurisdictional compliance (GDPR etc.)</td>
</tr>
<tr>
<td><strong>Sybil attack</strong></td>
<td>One actor creates many fake identities to game reputation</td>
<td>DID-based identity, proof-of-personhood (optional), reputation decay, contribution quality scoring, community moderation</td>
</tr>
</tbody>
</table>
<h3 id="72-access-control-model">7.2 Access control model</h3>
<pre><code>PUBLIC          — read all T1-T5 knowledge, search, ask AI
REGISTERED      — + submit contributions (T8 staging), endorse, comment
VERIFIED        — + T6 experience records, peer review, dispute resolution
EDITOR          — + promote/demote tiers, edit canonical nodes, merge duplicates
MODERATOR       — + remove spam/vandalism, suspend bad actors
GOVERNANCE      — + protocol changes, policy amendments, key rotation
</code></pre>
<p>Access is granted by reputation + community endorsement, not by payment.
<strong>No pay-to-edit. No pay-to-verify.</strong></p>
<h3 id="73-reputation-system">7.3 Reputation system</h3>
<ul>
<li>Every contribution starts with <code>reputation_delta = 0</code>.</li>
<li>Endorsements from VERIFIED users: <code>+1</code> to <code>+5</code> (weighted by endorser reputation).</li>
<li>Successful verification of your contribution: <code>+10</code>.</li>
<li>Contribution later found wrong/retracted: <code>-20</code>.</li>
<li>Vandalism/spam: <code>-50</code> + suspension.</li>
<li>Reputation decays over time (half-life ~180 days) to prevent entrenchment.</li>
<li>Reputation gates access tiers but <strong>never overrides epistemic tier</strong> —
  a high-reputation user can still only submit T8 claims that must be verified.</li>
</ul>
<h3 id="74-transparency-auditability">7.4 Transparency &amp; auditability</h3>
<ul>
<li><strong>All writes are logged</strong> in the hash-chained audit log.</li>
<li><strong>All tier changes are logged</strong> with reason and evidence.</li>
<li><strong>All AI answers are logged</strong> (privacy-preserving: query hash, not raw query,
  unless user opts in) for outcome learning and abuse detection.</li>
<li><strong>Public audit endpoint:</strong> anyone can verify the Merkle root and check
  inclusion proofs for any node.</li>
<li><strong>Open governance meetings:</strong> protocol changes proposed as <code>n:Proposal</code>
  nodes, debated publicly, ratified by stakeholder vote.</li>
</ul>
<h3 id="75-correction-protocol">7.5 Correction protocol</h3>
<p>When an error is found:</p>
<pre><code>1. Anyone can file a Dispute (POST /dispute) with evidence.
2. Dispute creates a n:Controversy node linking the disputed claim
   and the counter-evidence.
3. Affected claim is demoted one tier pending review.
4. Reviewers (VERIFIED+) examine evidence, may:
   a. Uphold original → controversy resolved, tier restored
   b. Accept correction → node updated, SUPERSEDES edge created,
      old version preserved in history
   c. Escalate → GOVERNANCE-level review
5. All steps are in the audit log. The correction itself is a knowledge
   node — &quot;we were wrong about X, here's how we found out.&quot;
</code></pre>
<p><strong>Corrections are celebrated, not hidden.</strong> A correction is proof the
system works. The archive's credibility depends on visible self-correction.</p>
<h3 id="76-privacy-model">7.6 Privacy model</h3>
<table>
<thead>
<tr>
<th>Data type</th>
<th>Protection</th>
</tr>
</thead>
<tbody>
<tr>
<td>Public knowledge (T1-T5)</td>
<td>Fully public, no privacy concern</td>
</tr>
<tr>
<td>Personal experiences (T6)</td>
<td>Contributor chooses: public / pseudonymous / private / embargoed</td>
</tr>
<tr>
<td>Sensitive experiences (medical, legal, indigenous)</td>
<td>Consent framework, cultural protocols, jurisdictional compliance</td>
</tr>
<tr>
<td>User identity</td>
<td>DID-based, minimal PII, pseudonymous by default</td>
</tr>
<tr>
<td>Query logs</td>
<td>Hashed for analytics; raw queries only with explicit opt-in</td>
</tr>
<tr>
<td>Aggregate statistics</td>
<td>Differential privacy (ε ≤ 1.0) for any public statistics</td>
</tr>
</tbody>
</table>
<p><strong>Right to be forgotten:</strong> contributors can request removal of their T6
records. The node is tombstoned (content replaced with hash + "removed at
contributor request") — the audit trail remains but the content is gone.
For truly sensitive data, cryptographic erasure (encrypt with key, destroy
key) is available.</p>
<hr />
<h2 id="8-global-accessibility">8. GLOBAL ACCESSIBILITY</h2>
<h3 id="81-multilingual-architecture">8.1 Multilingual architecture</h3>
<pre><code>Canonical layer:  knowledge stored in original language + English pivot
Translation layer: NLLB-200 / MADLAD-400 for 200-400 languages
Human layer:      community translations verified by native speakers
</code></pre>
<ul>
<li><strong>English is the pivot</strong>, not the only language. Every node can exist in
  multiple languages simultaneously.</li>
<li><strong>Machine translation is labeled</strong> — <code>machine_translated: true</code> until a
  human verifies it.</li>
<li><strong>Low-resource languages get priority</strong> — translation effort weighted
  toward languages with least existing digital knowledge.</li>
<li><strong>Oral languages:</strong> Whisper transcription + community validation.</li>
<li><strong>Indigenous knowledge:</strong> recorded in native language, translated with
  community consent, cultural protocols respected.</li>
</ul>
<h3 id="82-offline-low-bandwidth-access">8.2 Offline &amp; low-bandwidth access</h3>
<ul>
<li><strong>PWA with offline cache</strong> — core knowledge available offline.</li>
<li><strong>LanceDB embedded</strong> on edge devices — local vector search without server.</li>
<li><strong>Delta sync protocol</strong> — <code>GET /api/v1/sync?since=timestamp</code> returns only
  changed nodes since last sync. Bandwidth-efficient.</li>
<li><strong>Compressed knowledge packs</strong> — domain-specific bundles for offline
  education (e.g., "entire biology curriculum" as a 50MB download).</li>
<li><strong>SMS/USSD fallback</strong> for ultra-low-bandwidth regions <code>[SPEC: not yet
  practical for full archive, but feasible for Q&amp;A interface]</code>.</li>
</ul>
<h3 id="83-free-education-mandate">8.3 Free education mandate</h3>
<ul>
<li><strong>All T1-T3 knowledge is free to access, forever.</strong> No paywall.</li>
<li><strong>Structured learning paths</strong> — the knowledge hierarchy (Section 2)
  maps directly to curricula. A student can follow <code>Domain → Discipline →
  ... → Outcome</code> as a structured course.</li>
<li><strong>Open educational resources (OER) integration</strong> — link to and ingest
  existing OER (Khan Academy, MIT OCW, etc.).</li>
<li><strong>Multilingual curricula</strong> — the same learning path in 200+ languages.</li>
<li><strong>Accessibility</strong> — WCAG 2.2 compliant, screen-reader optimized,
  low-bandwidth mode, text-only mode.</li>
</ul>
<h3 id="84-community-contribution-model">8.4 Community contribution model</h3>
<ul>
<li><strong>Anyone can contribute</strong> — no gatekeeping for submission.</li>
<li><strong>Contribution types:</strong> new nodes, corrections, translations, experience
  records, endorsements, reviews, code (for the platform itself).</li>
<li><strong>Contributor rights:</strong></li>
<li>Attribution: every contribution carries author DID.</li>
<li>Portability: export your contributions at any time.</li>
<li>Governance: contribute to protocol discussions, vote on proposals.</li>
<li>Revenue share: if the archive ever generates revenue (donations,
    grants, premium services), contributors to canonical knowledge
    share in it via a transparent formula.</li>
<li><strong>Community moderation:</strong> distributed moderation with reputation-weighted
  voting, appeals process, and GOVERNANCE-level override for edge cases.</li>
</ul>
<h3 id="85-anti-capture-measures">8.5 Anti-capture measures</h3>
<p>The archive must be <strong>structurally uncapturable</strong>:</p>
<ol>
<li><strong>Open-source everything</strong> — code, schemas, protocols, governance docs.</li>
<li><strong>Federated storage</strong> — no single database holds all knowledge.
   IPFS content addressing means even if one node is seized, the content
   persists elsewhere.</li>
<li><strong>Multi-jurisdictional</strong> — nodes operated in multiple legal jurisdictions
   so no single government can shut it down.</li>
<li><strong>Constitutional governance</strong> — the protocol (not any operator) defines
   the rules. Operators are replaceable; the protocol is not.</li>
<li><strong>No surveillance</strong> — the archive does not track users beyond what's
   needed for abuse prevention. No behavioral advertising. No data sale.</li>
<li><strong>Transparent funding</strong> — all funding sources disclosed; no anonymous
   majority funders; no government that censors as majority funder.</li>
</ol>
